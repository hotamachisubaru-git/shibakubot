{
  "name": "discord-bot",
  "version": "1.5.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "register": "ts-node src/deploy-commands.ts",
    "register:prod": "node dist/deploy-commands.js",
    "test": "tsx --test test/*.test.ts",
    "migrate": "ts-node scripts/migrate-old-data.ts",
    "release:bundle": "npm run build && node scripts/create-release-bundle.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lavalink-client": "^2.10.3",
    "music-metadata": "^11.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "discord.js": {
      "undici": "6.27.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
