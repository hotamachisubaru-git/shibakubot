{
  "name": "discord-bot",
  "version": "2.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun scripts/clean-dist.mjs && bunx --bun tsc",
    "start": "bun dist/index.js",
    "register": "bun src/deploy-commands.ts",
    "register:prod": "bun dist/deploy-commands.js",
    "test": "bun test",
    "migrate": "bun scripts/migrate-old-data.ts",
    "release:bundle": "bun run build && bun scripts/create-release-bundle.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lavalink-client": "^2.10.3",
    "music-metadata": "^11.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "discord.js": {
      "undici": "6.29.1"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
